# Everything here is optional. Copy to .env to customize.

# Claude: by default the server uses your Claude Code login (the `claude` CLI).
# Set an API key only if you'd rather use the Anthropic API directly.
# ANTHROPIC_API_KEY=
# CLAUDE_BACKEND=cli        # cli | api
# CLAUDE_MODEL=opus         # CLI alias or full model id (API default: claude-opus-5)
# CLAUDE_EFFORT=medium      # low | medium | high | xhigh | max
# CLAUDE_BIN=claude         # path to the claude executable if it's not on PATH

# NASA: DEMO_KEY works but is limited to ~30 requests/hour. Free key: https://api.nasa.gov
# NASA_API_KEY=

PORT=8787
